{
    "name": "apiverve/exercises",
    "description": "Exercises filters movements by target muscle group, equipment, and exercise name, returning matching exercises with their force type and required gear. Paid plans add step-by-step instructions, difficulty levels, and movement mechanics.",
    "version": "1.2.2",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "exercises",
        "exercises api",
        "workout routine database",
        "exercise by muscle group",
        "gym workout movements",
        "dumbbell exercises lookup"
    ],
    "homepage": "https://apiverve.com/marketplace/exercises?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/exercises",
        "source": "https://github.com/apiverve/exercises-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Exercises\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "APIVerve\\Exercises\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
